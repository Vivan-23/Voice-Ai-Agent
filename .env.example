# =====================================================================
# Coway Voice AI Platform POC - Environment Configuration Template
# NOTE: DO NOT COMMIT REAL API KEYS OR SECRETS TO SOURCE CONTROL
# =====================================================================

# --- Server & Application Configuration ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Primary Conversational LLM (Groq) ---
# Groq provides ultra-low-latency Llama reasoning for real-time voice turns
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# Optional Fallback LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Runtime Local Knowledge ---
# Live customer calls use local versioned in-memory snapshot (< 1ms retrieval)
KNOWLEDGE_PROVIDER=local
KNOWLEDGE_SYNC_INTERVAL_MINUTES=15
KNOWLEDGE_SNAPSHOT_DIR=data/knowledge_snapshots

# --- ElevenLabs Speech Engine (STT + TTS + Interruption) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_SPEECH_ENGINE_ID=your_speech_engine_id_here
# For Local Development: wss://<your-ngrok-subdomain>.ngrok-free.app/ws/voice
# For Production:        wss://<your-render-service>.onrender.com/ws/voice
ELEVENLABS_PUBLIC_WS_URL=wss://your-service-domain.onrender.com/ws/voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- CORS & Frontend Integration ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
# Deployed Netlify frontend URL
FRONTEND_ORIGIN=https://your-site-name.netlify.app