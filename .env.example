# Voice AI Platform POC - Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO


# LLM (Groq is the primary conversational brain; Gemini supported as fallback)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Knowledge
KNOWLEDGE_PROVIDER=local
KNOWLEDGE_SYNC_INTERVAL_MINUTES=15

# ElevenLabs Speech Engine (STT + TTS + Barge-in Voice Layer)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_SPEECH_ENGINE_ID=your_speech_engine_id_here
ELEVENLABS_PUBLIC_WS_URL=wss://your-ngrok-domain.ngrok-free.app/ws/voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5